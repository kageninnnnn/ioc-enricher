# Copy to .env and fill in what you have. Every provider is optional:
# without a key it is skipped and only the bundled local intel feed is used.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
# abuse.ch Auth-Key (URLhaus + ThreatFox): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# Comma-separated client keys accepted in the X-API-Key header. Empty = auth disabled.
API_KEYS=
# Empty = in-memory cache (docker-compose sets redis://redis:6379/0)
REDIS_URL=
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=info
